[
  {
    "label": "Debug Current File",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": true
  },
  {
    "label": "Debug Current File (all code, incl. libraries)",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": false
  },
  {
    "label": "Debug Module",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "feelings",
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": true
  },
  {
    "label": "Debug Current Test File",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["$ZED_FILE", "-s"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": true
  },
  {
    "label": "Debug Failed Tests",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["--lf", "-s"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": true
  }
]
